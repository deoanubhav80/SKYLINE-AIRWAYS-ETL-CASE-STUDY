def route_scorecard(route):                                         # one function = one answer for the COO
    d = clean[clean["route"] == route]                              # all flights of this route
    if d.empty:                                                     # a route that does not exist
        print("No flights found for", route)                        # tell the user
        return                                                      # stop
    o = d[~d["is_cancelled"]]                                       # operated flights of this route
    otp = o["on_time"].mean() * 100                                 # on-time %
    avg = o["arr_delay_min"].mean()                                 # average arrival delay
    cancel = d["is_cancelled"].mean() * 100                         # cancellation %
    by_hour = o.groupby("hour_of_day")["arr_delay_min"].mean()      # average delay for each departure hour
    worst_hour = by_hour.idxmax()                                   # the hour with the most delay
    t = d[d["hour_of_day"] == worst_hour]["sched_dep"].dt.strftime("%H:%M").mode()[0]   # the scheduled departure time in that hour
    t2 = (pd.to_datetime(t, format="%H:%M") + pd.Timedelta(minutes=30)).strftime("%H:%M")   # the same time + 30 minutes
    bad = o[o["weather_day"] != "Clear"]["arr_delay_min"].mean()    # average delay on fog/rain days
    good = o[o["weather_day"] == "Clear"]["arr_delay_min"].mean()   # average delay on clear days
    gap = bad - good                                                # minutes the weather costs
    rank = int(route_kpi["otp_pct"].rank().loc[route])              # 1 = worst route of all
    print("=" * 56)                                                 # a line
    print("ROUTE SCORECARD:", route, "(", len(d), "scheduled flights )")   # heading
    print("On-time performance :", round(otp, 1), "%  (airline:", round(otp_overall, 1), "%, rank", rank, "of", len(route_kpi), "from worst)")   # OTP
    print("Average delay       :", round(avg, 1), "min")            # delay
    print("Worst hour          :", f"{worst_hour}:00 ({by_hour.max():.0f} min average, departure {t})")   # worst hour
    print("Cancellation rate   :", round(cancel, 1), "%")           # cancellations
    print("Weather effect      :", f"+{gap:.0f} min on fog/rain days ({bad:.0f} vs {good:.0f} min on clear days)")   # weather
    if gap >= 10:                                                   # weather matters on this route
        print("ADVICE: move the", t, "departure to", t2, "on fog/rain days.")   # shift the worst departure
    else:                                                           # weather is not the main reason
        print("ADVICE: add a 20-minute buffer to the", t, "departure; weather is not the main reason here.")   # buffer
    print("=" * 56)                                                 # a line

